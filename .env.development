# 微信小程序本地开发环境
# 注意：这里的值会被编译进产物包体，只能放公开信息，绝不能放密钥 / token

# 环境标识
VITE_APP_ENV=development

# 应用标题
VITE_APP_TITLE=fishing

# 接口基址（需在微信后台配置为 request 合法域名）
VITE_API_BASE_URL=https://api.kanocifer.chat

# 和风天气图标字体的网络地址（需在微信后台配置为 downloadFile 合法域名）
# 默认值是 jsdelivr 上的全量字体；生产环境建议换成自建 CDN 托管的子集
VITE_QWEATHER_FONT_URL=https://cdn.jsdelivr.net/npm/qweather-icons@1.8.0/font/fonts/qweather-icons.woff

# 静态资源 CDN 基址（需在微信后台配置为 downloadFile 合法域名）
# 缺图占位插画在这儿：<CDN 基址>/spots.jpg
VITE_CDN_BASE_URL=https://cdn.kanocifer.chat/yulu

# 开启调试日志（生产构建请保持 false）
VITE_ENABLE_LOG=true
