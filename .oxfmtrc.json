{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "printWidth": 120,
  "trailingComma": "all",
  "jsxSingleQuote": false,
  "sortTailwindcss": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".output/",
    ".wxt/",
    ".traces/",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".impeccable/",
    ".DS_Store",
    ".git/"
  ]
}
