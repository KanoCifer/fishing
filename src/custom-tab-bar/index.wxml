<view class="tabbar {{surface === 'photo' ? 'tabbar--photo' : ''}}">
  <view class="tabbar__row">
    <view
      wx:for="{{list}}"
      wx:key="key"
      class="tabbar__item"
      data-key="{{item.key}}"
      bindtap="onTap"
      hover-class="tabbar__item--press"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <!--
        动作键（记一笔）：没有文字，圆键自己就是那枚标签。
        它不参与选中态 —— 「在哪一格」与「现在能做什么」是两件事。
      -->
      <view wx:if="{{item.type === 'action'}}" class="tabbar__action">
        <image class="tabbar__action-icon" src="{{item.icon}}" mode="aspectFit" />
      </view>

      <!--
        导航格：图标与文字是选中态药丸的两半，不是两次表态。
        药丸只托住「在哪一格」，颜色变化是它的副产品。
      -->
      <view wx:else class="tabbar__cell {{item.key === selectedKey ? 'tabbar__cell--on' : ''}}">
        <!--
          两枚图标叠着放，一枚浅色一枚深色，由 WXSS 的媒体查询决定露哪一枚。

          为什么不在 JS 里换 src：底栏是原生组件，拿不到 uni 的主题真值，
          自己再探一次系统主题就多一份判断。媒体查询跟着系统走，
          切主题时页面与底栏是同一帧翻的，不会一个先翻一个后翻。
        -->
        <image
          class="tabbar__icon tabbar__icon--light"
          src="{{item.key === selectedKey ? item.activeIcon : item.icon}}"
          mode="aspectFit"
        />
        <image
          class="tabbar__icon tabbar__icon--dark"
          src="{{item.key === selectedKey ? item.activeIconDark : item.iconDark}}"
          mode="aspectFit"
        />
        <text class="tabbar__label {{item.key === selectedKey ? 'tabbar__label--on' : ''}}">{{item.text}}</text>
      </view>
    </view>
  </view>
</view>
