.tabbar {
  /* ── 深玻璃那一档 ────────────────────────────────────────────
     照片面与深色系统共用这一份。值取自令牌层的深色段：
     = --fish-glass-strong（深色）
     = --fish-glass-edge（深色）
     = 深色档选中药丸 rgba(76, 155, 255, 0.18)
     = --fish-muted-60（深色）
     = --fish-blue-600（深色档） */
  --tb-bg-deep: rgba(25, 25, 25, 0.32);
  --tb-edge-deep: rgba(255, 255, 255, 0.14);
  --tb-pill-deep: rgba(76, 155, 255, 0.18);
  --tb-label-deep: #8e939c;
  --tb-label-on-deep: #4c9bff;

  /* ── 页面底那一档 ────────────────────────────────────────────
     = $fish-glass-strong / --fish-glass-strong
     = $fish-border-40（浅色）—— 顶边是发丝线，不是高光
     = 浅色档选中药丸 rgba(15, 102, 214, 0.12)
     = $fish-muted-60
     = $fish-blue */
  --tb-bg-light: rgba(255, 255, 255, 0.3);
  --tb-edge-light: rgba(60, 60, 67, 0.18);
  --tb-pill-light: rgba(15, 102, 214, 0.12);
  --tb-label-light: #666666;
  --tb-label-on-light: #0f66d6;

  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;

  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);

  background-color: var(--tb-bg-light);
  /* = $fish-blur */
  backdrop-filter: blur(20px) saturate(1.8);
  -webkit-backdrop-filter: blur(20px) saturate(1.8);
  /* 顶边是发丝线，不是高光 */
  box-shadow: inset 0 1rpx 0 var(--tb-edge-light);
}

/* 一行五格 */
.tabbar__row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 100rpx;
  padding: 0 8rpx;
}

/* 一格。按压回弹在这层，动画在里层，两者不打架 */
.tabbar__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 100%;

  transition: transform 260ms cubic-bezier(0.2, 0, 0, 1);
}

.tabbar__item--press {
  transform: scale(0.96);
}

/*
 * 导航格 —— 药丸。
 *
 * 选中态不是「图标变蓝 + 文字变蓝」这种两次表态，而是整块被托起来：
 * 药丸是唯一的表态位，颜色变化只是它的副产品。
 */
.tabbar__cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;

  /* = $fish-ease-out */
  animation: tabbar-cell-in 260ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.tabbar__cell--on {
  background-color: var(--tb-pill-light);
}

@keyframes tabbar-cell-in {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 图标。固定盒子，两态换图不换盒子 */
.tabbar__icon {
  width: 44rpx;
  height: 44rpx;
}

/*
 * 深色那枚默认藏着。
 *
 * 底栏是原生组件，不在 page 的作用域里 —— 拿不到 theme.scss 里定义的
 * CSS 变量，也继承不到 page 上的那些。所以底栏自带一套深色值，
 * 用媒体查询切，跟页面层用的是同一个系统信号。
 */
.tabbar__icon--dark {
  display: none;
}

/*
 * 文字。20rpx（10px）—— 与原生 tabBar 同一档（pages.json 没配 fontSize，
 * 默认 10px）。
 */
.tabbar__label {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  /* 未选中这一档，图标烤进 PNG，用的是同一个值 */
  color: var(--tb-label-light);

  /* = $fish-ease-out */
  transition: color 260ms cubic-bezier(0.23, 1, 0.32, 1);
}

.tabbar__label--on {
  color: var(--tb-label-on-light);
  font-weight: 500;
}

/*
 * 动作键（记一笔）。
 *
 * 它不参与选中态：「在哪一格」与「现在能做什么」是两件事，
 * 一件事只说一遍。圆键自己就是那枚标签，所以没有文字。
 */
.tabbar__action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 80rpx;
  height: 80rpx;
  /* = $fish-radius-pill */
  border-radius: 999rpx;
  /* = $fish-gradient */
  background-image: linear-gradient(135deg, #1a6ee0 0%, #0f66d6 55%, #1a4fa0 100%);
  box-shadow: 0 10rpx 24rpx rgba(13, 28, 44, 0.22);

  /* = $fish-ease-out */
  animation: tabbar-cell-in 260ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.tabbar__action-icon {
  width: 38rpx;
  height: 38rpx;
}

@media (prefers-color-scheme: dark) {
  .tabbar {
    background-color: var(--tb-bg-deep);
    box-shadow: inset 0 1rpx 0 var(--tb-edge-deep);
  }

  .tabbar__cell--on {
    background-color: var(--tb-pill-deep);
  }

  .tabbar__label {
    color: var(--tb-label-deep);
  }

  .tabbar__label--on {
    color: var(--tb-label-on-deep);
  }

  .tabbar__icon--light {
    display: none;
  }

  .tabbar__icon--dark {
    display: block;
  }
}
