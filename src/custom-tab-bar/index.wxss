/*
 * 自定义 tabBar 的样式。
 *
 * ⚠️ 这个目录**不经过 uni-app 编译**：uni-app 把它原样拷到小程序代码根目录，
 * 所以这里不能写 SCSS、不能引令牌层，色值只能写死。
 * 下面的十六进制与 src/styles/tokens/_color.scss 一一对应（改色两处一起改）：
 *   #ffffff      底栏底色        = $fish-page
 *   #3c3c43      页签文字        = pages.json 的 color
 *   #007aff      选中文字        = pages.json 的 selectedColor
 *   #1a6ee0/#0f66d6/#1a4fa0  动作键渐变 = $fish-gradient
 *   rgba(60,60,67,0.29) 发丝线   = $fish-border
 *
 * 底栏高度 150rpx（=75px），格子里是 100rpx（=50px，与原生 tabBar 同一档）。
 */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;

  display: flex;
  box-sizing: border-box;
  height: 150rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);

  background-color: #ffffff;
  border-top: 1rpx solid rgba(60, 60, 67, 0.29);
}

/* 一格。flex:1 平分底栏 */
.tabbar__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 100rpx;
}

/* 图标盒。固定大小，选中态与常态换的是图不是盒子 */
.tabbar__iconbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.tabbar__icon {
  width: 48rpx;
  height: 48rpx;
}

/*
 * 文字。
 *
 * 20rpx（10px）—— 与原生 tabBar 同一档（pages.json 没配 fontSize，默认 10px）。
 */
.tabbar__label {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  color: #3c3c43;
}

.tabbar__label--on {
  color: #007aff;
}

/*
 * 中间那格：动作键。
 *
 * 它不是页签，是一个动作 —— 凸出底栏上沿、做成实心圆，
 * 一眼就知道这里跟别的不一样（其余四格都是小图标 + 文字）。
 *
 * 直径 116rpx（58px）、底边压在底栏内 4rpx 处，于是上沿高出底栏 20rpx（10px）——
 * 凸起的那一截不多不少：再多就抢了地图页的视野。
 *
 * 白描边是必须的：圆键探出底栏的那一截底下是页面内容，
 * 没有这圈白边它会和内容糊在一起。
 */
.tabbar__item--action {
  position: relative;
}

.tabbar__iconbox--action {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  box-sizing: border-box;
  width: 116rpx;
  height: 116rpx;
  margin-left: -58rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background-image: linear-gradient(135deg, #1a6ee0 0%, #0f66d6 55%, #1a4fa0 100%);
  box-shadow: 0 6rpx 16rpx rgba(9, 24, 40, 0.24);
}

.tabbar__iconbox--action .tabbar__icon {
  width: 48rpx;
  height: 48rpx;
}

/* 动作键没有文字标签：圆键自己就是那枚标签 */
.tabbar__item--action .tabbar__label {
  display: none;
}
