   if (this.hook(node)) {
     // #ifdef MP-WEIXIN
-    if (this.options.selectable === 'force' && system.includes('iOS') && !uni.canIUse('rich-text.user-select')) {
+    if (this.options.selectable === 'force' && getSystem().includes('iOS') && !uni.canIUse('rich-text.user-select')) {
       this.expose()
     }
